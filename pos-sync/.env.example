# Choice QR OAuth credentials (required)
CHOICE_CLIENT_ID=your_client_id_here
CHOICE_CLIENT_SECRET=your_client_secret_here

# Anthropic API key (optional — AI matching disabled if not set)
ANTHROPIC_API_KEY=sk-ant-...

# Set to false to disable AI matching even if ANTHROPIC_API_KEY is present
AI_MATCH_ENABLED=true

PORT=3000
